# ─────────────────────────────────────────────────────────────────────────────
# ZURI App — Environment Configuration Template
# ─────────────────────────────────────────────────────────────────────────────
# This file is safe to commit. It shows all required keys without real values.
# To get started: copy this file → .env and fill in your real keys.
#
#   cp .env.example .env
#
# ─────────────────────────────────────────────────────────────────────────────

# ── App Environment ──────────────────────────────────────────────────────────
# Options: development | production
APP_ENV=development

# ── Google Maps ──────────────────────────────────────────────────────────────
# Get your key at: https://console.cloud.google.com
# Enable: Maps SDK for Android
GOOGLE_MAPS_API_KEY=

# ── Flutterwave Payment ──────────────────────────────────────────────────────
# Get your key at: https://dashboard.flutterwave.com → Settings → API Keys
# Test key starts with: FLWPUBK_TEST-
# Live key starts with: FLWPUBK-
FLUTTERWAVE_PUBLIC_KEY=

# Set to true in development, false in production
FLUTTERWAVE_TEST_MODE=true
